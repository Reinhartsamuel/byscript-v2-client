{
  "rewrites": [
    { "source": "/_next/:path*", "destination": "https://byscript-web.vercel.app/_next/:path*" },
    { "source": "/web/:path*", "destination": "https://byscript-web.vercel.app/web/:path*" },
    { "source": "/chart", "destination": "https://byscript-web.vercel.app/web/chart" },
    { "source": "/signals", "destination": "https://byscript-web.vercel.app/web/signals" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}